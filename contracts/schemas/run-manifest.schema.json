{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest@2",
  "title": "Run Manifest v2",
  "description": "Immutable, revision-chained ledger for one project-bound autonomous internal pipeline run.",
  "type": "object",
  "required": [
    "project_id",
    "project_profile_revision",
    "manifest_version",
    "manifest_revision",
    "previous_manifest",
    "run_id",
    "run_mode",
    "status",
    "objective",
    "coordinator_plan",
    "project_context",
    "route_id",
    "route_contract",
    "planned_steps",
    "tasks",
    "output_artifacts",
    "review_items",
    "publish_side_effects",
    "blocked_reason",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "project_profile_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "manifest_version": {
      "const": "2.0"
    },
    "manifest_revision": {
      "type": "integer",
      "minimum": 1
    },
    "previous_manifest": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "artifact_ref",
            "artifact_revision",
            "artifact_sha256"
          ],
          "properties": {
            "artifact_ref": {
              "type": "string",
              "pattern": "^records/runs/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"
            },
            "artifact_revision": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "artifact_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "run_mode": {
      "enum": [
        "fixture",
        "live",
        "discovery"
      ]
    },
    "status": {
      "enum": [
        "queued",
        "running",
        "awaiting_review",
        "completed",
        "blocked",
        "failed"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "coordinator_plan": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^records/coordinator-plans/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "project_context": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "route_contract": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "planned_steps": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "role_id",
          "depends_on",
          "output_contract"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "role_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,63}$"
            }
          },
          "output_contract": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]+@[0-9]+$"
          }
        },
        "additionalProperties": false
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "step_id",
          "task_id",
          "task_ref",
          "task_sha256",
          "status",
          "result_ref"
        ],
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,63}$"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
          },
          "task_ref": {
            "type": "string",
            "pattern": "^handoffs/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"
          },
          "task_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "status": {
            "enum": [
              "queued",
              "running",
              "completed",
              "blocked",
              "needs_attention",
              "failed"
            ]
          },
          "result_ref": {
            "oneOf": [
              {
                "type": "object",
                "required": [
                  "artifact_ref",
                  "artifact_revision",
                  "artifact_sha256"
                ],
                "properties": {
                  "artifact_ref": {
                    "type": "string",
                    "pattern": "^handoffs/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"
                  },
                  "artifact_revision": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                  },
                  "artifact_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "queued",
                    "running"
                  ]
                }
              },
              "required": [
                "status"
              ]
            },
            "then": {
              "properties": {
                "result_ref": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "result_ref": {
                  "type": "object"
                }
              }
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "output_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "artifact_revision",
          "artifact_sha256"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          },
          "artifact_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "review_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "artifact_revision",
          "artifact_sha256"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string",
            "pattern": "^outbox/pending/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$"
          },
          "artifact_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "publish_side_effects": {
      "const": false
    },
    "blocked_reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "manifest_revision": {
            "const": 1
          }
        },
        "required": [
          "manifest_revision"
        ]
      },
      "then": {
        "properties": {
          "previous_manifest": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "previous_manifest": {
            "type": "object"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "queued",
              "running"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "completed_at": {
            "type": "null"
          },
          "blocked_reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "queued"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "status": {
                  "const": "queued"
                }
              },
              "required": [
                "status"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "awaiting_review"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "output_artifacts": {
            "minItems": 1
          },
          "review_items": {
            "minItems": 1
          },
          "blocked_reason": {
            "type": "null"
          },
          "completed_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "completed"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "tasks": {
            "items": {
              "properties": {
                "status": {
                  "const": "completed"
                }
              },
              "required": [
                "status"
              ]
            }
          },
          "output_artifacts": {
            "minItems": 1
          },
          "review_items": {
            "minItems": 1
          },
          "blocked_reason": {
            "type": "null"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "failed"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "blocked_reason": {
            "type": "string",
            "minLength": 1
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
