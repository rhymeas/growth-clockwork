        {"step_id": "governance-final", "role_id": "governance-reviewer", "depends_on": ["organic-package"], "optional": false, "run_when": "always", "objective": "Review the exact organic audience-readiness package and any supporting channel product for complete value, claims, privacy, rights, relationship boundaries, revision binding, and no-launch compliance.", "output_contract": "result-envelope@2", "deliverable_contract": "governance-verdict@1", "allowed_write_roots": ["handoffs", "records/governance"]}
      ],
