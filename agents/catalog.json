        {"step_id": "social-product", "role_id": "social-media", "depends_on": ["audience-evidence", "community-insight", "developer-journey"], "optional": true, "run_when": "Activate only when the selected organic objective includes one enabled social surface with current channel rules, metric definitions, and a human account owner.", "objective": "Produce one complete platform-native channel product bound to exact claims, sources, limitations, and any activated community or developer findings without posting it.", "output_contract": "result-envelope@2", "deliverable_contract": "social-package@1", "allowed_write_roots": ["handoffs", "staging"]},
