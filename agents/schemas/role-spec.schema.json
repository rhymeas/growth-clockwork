{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "role-spec@1",
  "title": "Portable Growth Role Specification",
  "type": "object",
  "required": [
    "spec_version",
    "role_id",
    "display_name",
    "role_class",
    "mission",
    "capabilities",
    "owns",
    "does_not_own",
    "activation",
    "inputs",
    "outputs",
    "dependencies",
    "authority",
    "quality_rules",
    "stop_conditions",
    "handoff_contracts"
  ],
  "properties": {
    "spec_version": {
      "const": "1.0"
    },
    "role_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "role_class": {
      "enum": [
        "core",
        "specialist"
      ]
    },
    "mission": {
      "type": "string",
      "minLength": 20
    },
    "capabilities": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "owns": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "does_not_own": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "activation": {
      "type": "object",
      "required": [
        "modes",
        "profile_default",
        "conditions",
        "prerequisites"
      ],
      "properties": {
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "always_control",
              "required_by_route",
              "mandatory_by_product_motion",
              "activated_by_observed_trigger"
            ]
          }
        },
        "profile_default": {
          "enum": [
            "enabled",
            "disabled",
            "profile_decides"
          ]
        },
        "conditions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        },
        "prerequisites": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contractRef"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/outputRef"
      }
    },
    "dependencies": {
      "type": "object",
      "required": [
        "required_roles",
        "may_run_parallel_with"
      ],
      "properties": {
        "required_roles": {
          "$ref": "#/$defs/roleIds"
        },
        "may_run_parallel_with": {
          "$ref": "#/$defs/roleIds"
        }
      },
      "additionalProperties": false
    },
    "authority": {
      "type": "object",
      "required": [
        "autonomous_internal_work",
        "direct_persistence",
        "network",
        "external_side_effects",
        "may_publish",
        "may_send",
        "may_spend",
        "may_modify_accounts",
        "allowed_internal_actions"
      ],
      "properties": {
        "autonomous_internal_work": {
          "const": true
        },
        "direct_persistence": {
          "const": false
        },
        "network": {
          "enum": [
            "none",
            "allowlisted-read-only",
            "adapter-read-only"
          ]
        },
        "external_side_effects": {
          "const": false
        },
        "may_publish": {
          "const": false
        },
        "may_send": {
          "const": false
        },
        "may_spend": {
          "const": false
        },
        "may_modify_accounts": {
          "const": false
        },
        "allowed_internal_actions": {
          "$ref": "#/$defs/nonEmptyUniqueStrings"
        }
      },
      "additionalProperties": false
    },
    "quality_rules": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "stop_conditions": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "handoff_contracts": {
      "type": "object",
      "required": [
        "task",
        "result"
      ],
      "properties": {
        "task": {
          "const": "task-envelope@2"
        },
        "result": {
          "const": "result-envelope@2"
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "roleIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{1,63}$"
      }
    },
    "contractRef": {
      "type": "object",
      "required": [
        "input_id",
        "contract",
        "required",
        "requirements"
      ],
      "properties": {
        "input_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+@[0-9]+$"
        },
        "required": {
          "type": "boolean"
        },
        "requirements": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "outputRef": {
      "type": "object",
      "required": [
        "output_id",
        "contract",
        "purpose"
      ],
      "properties": {
        "output_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "contract": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]+@[0-9]+$"
        },
        "purpose": {
          "type": "string",
          "minLength": 10
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
