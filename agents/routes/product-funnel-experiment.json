    {"node_id": "experiment-owner", "role_id": "growth-product-cro", "depends_on": ["friction-evidence", "baseline"], "optional": false, "run_when": "always", "objective": "Diagnose the bottleneck and specify the smallest trustworthy product experiment.", "output_contract": "result-envelope@2", "deliverable_contract": "experiment-charter@1", "allowed_write_roots": ["records/experiments", "handoffs"]},
    {"node_id": "measurement-design", "role_id": "analytics-experimentation", "depends_on": ["experiment-owner"], "optional": false, "run_when": "always", "objective": "Bind metrics, guardrails, power strategy, runtime, data-quality checks, and decision rule.", "output_contract": "result-envelope@2", "deliverable_contract": "measurement-plan@1", "allowed_write_roots": ["records/learning", "handoffs"]},
    {"node_id": "governance-final", "role_id": "governance-reviewer", "depends_on": ["experiment-owner", "measurement-design"], "optional": false, "run_when": "always", "objective": "Review the exact experiment charter and measurement plan for evidence, ethics, privacy, authority, and causal boundaries.", "output_contract": "result-envelope@2", "deliverable_contract": "governance-verdict@1", "allowed_write_roots": ["records/governance", "handoffs"]}
