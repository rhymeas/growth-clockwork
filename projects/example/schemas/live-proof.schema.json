{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "live-proof@1",
  "title": "Release Live Proof",
  "description": "Evidence record describing what was actually observed after an adapter execution.",
  "type": "object",
  "required": ["live_proof_version", "proof_id", "project_id", "project_profile_revision", "release_package", "adapter_receipt", "proof_scope", "verification_status", "publicly_live", "external_side_effects", "evidence", "observed_at"],
  "properties": {
    "live_proof_version": { "const": "1.0" },
    "proof_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "project_profile_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "release_package": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "minLength": 1 },
        "artifact_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "adapter_receipt": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "pattern": "^records/adapter-receipts/[A-Za-z0-9][A-Za-z0-9._/-]{0,255}\\.json$" },
        "artifact_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "proof_scope": { "const": "local-fixture-only" },
    "verification_status": { "const": "verified" },
    "publicly_live": { "const": false },
    "external_side_effects": { "const": false },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
        "properties": {
          "artifact_ref": { "type": "string", "pattern": "^staging/local-release/[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
          "artifact_revision": { "type": "string", "minLength": 1 },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "observed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
