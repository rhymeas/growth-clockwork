{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-memory-record@1",
  "title": "Project Memory Record",
  "description": "Append-only, project-bound memory. It stores evidence-backed decisions, learnings, outcomes, feedback, and corrections; it is not a transcript or an LLM summary cache.",
  "type": "object",
  "required": [
    "project_id",
    "project_profile_revision",
    "record_version",
    "memory_id",
    "memory_revision",
    "memory_type",
    "claim_mode",
    "statement",
    "tags",
    "evidence",
    "evidence_grade",
    "decision_eligible",
    "causal_claim",
    "experiment_ref",
    "supersedes",
    "confidence",
    "source_run_id",
    "source_task_id",
    "created_by",
    "contains_personal_data",
    "valid_from",
    "expires_at",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "project_profile_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "record_version": {
      "const": "1.0"
    },
    "memory_id": {
      "type": "string",
      "pattern": "^MEM-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
    },
    "memory_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
    },
    "memory_type": {
      "enum": [
        "decision",
        "learning",
        "outcome",
        "human_feedback",
        "context_correction"
      ]
    },
    "claim_mode": {
      "enum": [
        "observation",
        "hypothesis",
        "experiment_result",
        "instruction"
      ]
    },
    "statement": {
      "type": "string",
      "minLength": 10
    },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "artifact_revision",
          "artifact_sha256",
          "relation"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          },
          "artifact_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "relation": {
            "enum": ["supports", "disconfirms", "authorizes", "records"]
          }
        },
        "additionalProperties": false
      }
    },
    "evidence_grade": {
      "enum": ["authoritative", "verified", "directional", "exploratory"]
    },
    "decision_eligible": {
      "type": "boolean"
    },
    "causal_claim": {
      "type": "boolean"
    },
    "experiment_ref": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "supersedes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^MEM-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$"
      }
    },
    "confidence": {
      "enum": ["low", "medium", "high", "not_applicable"]
    },
    "source_run_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "source_task_id": {
      "type": ["string", "null"],
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "created_by": {
      "enum": ["operator", "growth-clockwork-root", "workhorse"]
    },
    "contains_personal_data": {
      "const": false
    },
    "valid_from": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "oneOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "causal_claim": {
            "const": true
          }
        },
        "required": ["causal_claim"]
      },
      "then": {
        "properties": {
          "claim_mode": {
            "const": "experiment_result"
          },
          "experiment_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_grade": {
            "const": "exploratory"
          }
        },
        "required": ["evidence_grade"]
      },
      "then": {
        "properties": {
          "decision_eligible": {
            "const": false
          },
          "claim_mode": {
            "const": "hypothesis"
          },
          "causal_claim": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "causal_claim": {
            "const": true
          }
        },
        "required": ["causal_claim"]
      },
      "then": {
        "properties": {
          "evidence_grade": {
            "const": "verified"
          },
          "decision_eligible": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "claim_mode": {
            "enum": ["observation", "hypothesis", "instruction"]
          }
        },
        "required": ["claim_mode"]
      },
      "then": {
        "properties": {
          "causal_claim": {
            "const": false
          },
          "experiment_ref": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "human_feedback"
          }
        },
        "required": ["memory_type"]
      },
      "then": {
        "properties": {
          "claim_mode": {
            "const": "instruction"
          },
          "created_by": {
            "const": "operator"
          },
          "confidence": {
            "const": "not_applicable"
          },
          "evidence_grade": {
            "const": "authoritative"
          },
          "decision_eligible": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
