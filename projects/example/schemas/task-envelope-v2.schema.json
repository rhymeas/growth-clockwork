{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-envelope@2",
  "title": "Task Envelope v2",
  "description": "Immutable work order bound to one project context, route step, role contract, and route contract.",
  "type": "object",
  "required": [
    "project_id",
    "project_profile_revision",
    "task_version",
    "task_id",
    "run_id",
    "step_id",
    "depends_on",
    "assigned_role",
    "role_contract",
    "route_id",
    "route_contract",
    "objective",
    "project_context",
    "input_artifacts",
    "output_contract",
    "authority",
    "created_at"
  ],
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "project_profile_revision": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "task_version": {
      "const": "2.0"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "depends_on": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$"
      }
    },
    "assigned_role": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "role_contract": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "route_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$"
    },
    "route_contract": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "objective": {
      "type": "string",
      "minLength": 10
    },
    "project_context": {
      "type": "object",
      "required": [
        "artifact_ref",
        "artifact_revision",
        "artifact_sha256"
      ],
      "properties": {
        "artifact_ref": {
          "type": "string",
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
        },
        "artifact_revision": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "artifact_ref",
          "artifact_revision",
          "artifact_sha256"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$"
          },
          "artifact_revision": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "output_contract": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]+@[0-9]+$"
    },
    "authority": {
      "type": "object",
      "required": [
        "allowed_write_roots",
        "external_side_effects",
        "may_publish"
      ],
      "properties": {
        "allowed_write_roots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
          }
        },
        "external_side_effects": {
          "const": false
        },
        "may_publish": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
