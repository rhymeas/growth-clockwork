{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "learning-record@1",
  "title": "Learning Record",
  "description": "Append-only learning with explicit evidence and causal-claim boundary.",
  "type": "object",
  "required": [
    "project_id",
    "project_profile_revision",
    "record_version",
    "learning_id",
    "run_id",
    "task_id",
    "learning_type",
    "statement",
    "evidence",
    "causal_claim",
    "experiment_ref",
    "confidence",
    "recommended_change",
    "supersedes",
    "created_at"
  ],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "project_profile_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "record_version": { "const": "1.0" },
    "learning_id": { "type": "string", "pattern": "^LR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "task_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
    "learning_type": { "enum": ["observation", "hypothesis", "experiment_result"] },
    "statement": { "type": "string", "minLength": 10 },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
        "properties": {
          "artifact_ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
          "artifact_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "causal_claim": { "type": "boolean" },
    "experiment_ref": {
      "oneOf": [
        { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        { "type": "null" }
      ]
    },
    "confidence": { "enum": ["low", "medium", "high"] },
    "recommended_change": { "type": "string", "minLength": 1 },
    "supersedes": {
      "oneOf": [
        { "type": "string", "pattern": "^LR-[A-Za-z0-9][A-Za-z0-9._-]{2,63}$" },
        { "type": "null" }
      ]
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "causal_claim": { "const": true } },
        "required": ["causal_claim"]
      },
      "then": {
        "properties": {
          "learning_type": { "const": "experiment_result" },
          "experiment_ref": { "type": "string", "minLength": 1 }
        }
      }
    },
    {
      "if": {
        "properties": { "learning_type": { "enum": ["observation", "hypothesis"] } },
        "required": ["learning_type"]
      },
      "then": {
        "properties": {
          "causal_claim": { "const": false },
          "experiment_ref": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
