{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release-outcome@1",
  "title": "Release Outcome Record",
  "description": "Append-only observation following a release proof; fixture observations never claim causality.",
  "type": "object",
  "required": ["outcome_record_version", "outcome_id", "project_id", "project_profile_revision", "release_package", "adapter_receipt", "live_proof", "outcome_type", "statement", "metrics", "causal_claim", "external_side_effects", "recorded_at"],
  "properties": {
    "outcome_record_version": { "const": "1.0" },
    "outcome_id": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$" },
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "project_profile_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "release_package": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "minLength": 1 },
        "artifact_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "adapter_receipt": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "minLength": 1 },
        "artifact_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "live_proof": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "minLength": 1 },
        "artifact_revision": { "type": "string", "minLength": 1 },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "outcome_type": { "const": "fixture-observation" },
    "statement": { "type": "string", "minLength": 10 },
    "metrics": { "type": "array", "maxItems": 0 },
    "causal_claim": { "const": false },
    "external_side_effects": { "const": false },
    "recorded_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
