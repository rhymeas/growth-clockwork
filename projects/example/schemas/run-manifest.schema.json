{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-manifest@1",
  "title": "Run Manifest",
  "description": "Project-bound ledger for one autonomous internal pipeline run.",
  "type": "object",
  "required": [
    "project_id",
    "project_profile_revision",
    "manifest_version",
    "run_id",
    "status",
    "objective",
    "project_context",
    "routes",
    "tasks",
    "output_artifacts",
    "review_items",
    "publish_side_effects",
    "started_at",
    "completed_at"
  ],
  "properties": {
    "project_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
    "project_profile_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$" },
    "manifest_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
    "status": { "enum": ["queued", "running", "completed", "blocked", "failed"] },
    "objective": { "type": "string", "minLength": 10 },
    "project_context": {
      "type": "object",
      "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
      "properties": {
        "artifact_ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
        "artifact_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["task_id", "task_ref", "task_sha256", "status"],
        "properties": {
          "task_id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9._:-]{2,127}$" },
          "task_ref": { "type": "string", "pattern": "^handoffs/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$" },
          "task_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "status": { "enum": ["queued", "running", "completed", "blocked", "failed"] }
        },
        "additionalProperties": false
      }
    },
    "output_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
        "properties": {
          "artifact_ref": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9][A-Za-z0-9._/-]{0,255}$" },
          "artifact_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "review_items": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["artifact_ref", "artifact_revision", "artifact_sha256"],
        "properties": {
          "artifact_ref": { "type": "string", "pattern": "^outbox/pending/[A-Za-z0-9][A-Za-z0-9._/-]{1,255}$" },
          "artifact_revision": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
          "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "additionalProperties": false
      }
    },
    "publish_side_effects": { "const": false },
    "started_at": { "type": "string", "format": "date-time" },
    "completed_at": {
      "oneOf": [
        { "type": "string", "format": "date-time" },
        { "type": "null" }
      ]
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "enum": ["queued", "running"] } }, "required": ["status"] },
      "then": { "properties": { "completed_at": { "type": "null" } } }
    },
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "completed_at": { "type": "string", "format": "date-time" },
          "tasks": { "items": { "properties": { "status": { "const": "completed" } }, "required": ["status"] } },
          "output_artifacts": { "minItems": 1 },
          "review_items": { "minItems": 1 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["blocked", "failed"] } }, "required": ["status"] },
      "then": { "properties": { "completed_at": { "type": "string", "format": "date-time" } } }
    }
  ],
  "additionalProperties": false
}
